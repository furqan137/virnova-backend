PORT=5000
# On Render, do not set PORT — the platform sets it.
# Local: mongodb://127.0.0.1:27017/virnova  |  Atlas: mongodb+srv://user:pass@cluster.mongodb.net/virnova
MONGODB_URI=
# Alias supported in code: MONGO_URI (same value as MONGODB_URI)
# MONGO_URI=
# Set to 1 only if you must run the API without Mongo (auth/history/settings will not work).
MONGO_OPTIONAL=
# Extra browser origins (comma-separated). Defaults already include https://virnova-frontend.vercel.app and *.vercel.app
CORS_ORIGIN=
# Set to 1 only for debugging — allows any origin (not recommended in production)
# CORS_ALLOW_ALL=
WAVESPEED_API_KEY=
# Optional: only used if you wire OpenAI separately
# OPENAI_API_KEY=
WAVESPEED_MODEL=bytedance-seed/seed-1.6-flash
JWT_SECRET=change-me-long-random-string
