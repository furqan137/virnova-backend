PORT=5000
# On Render, do not set PORT — the platform sets it.
# Local: mongodb://127.0.0.1:27017/virnova  |  Atlas: mongodb+srv://user:pass@cluster.mongodb.net/virnova
MONGODB_URI=
# Set to 1 only if you must run the API without Mongo (auth/history/settings will not work).
MONGO_OPTIONAL=
# Comma-separated browser origins (Vercel). Example: https://myapp.vercel.app,https://myapp-git-main-x.vercel.app
CORS_ORIGIN=
WAVESPEED_API_KEY=
WAVESPEED_MODEL=bytedance-seed/seed-1.6-flash
JWT_SECRET=change-me-long-random-string
